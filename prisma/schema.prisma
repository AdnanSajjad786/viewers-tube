// VIEWERS TUBE — Core platform database

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum AccountType {
  VIEWER
  CREATOR
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
  REMOVED
}

enum StrikeStatus {
  ACTIVE
  REVERSED
}

enum AppealStatus {
  OPEN
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum StorageConnectionStatus {
  PENDING
  VERIFIED
  ERROR
}

enum VideoProvider {
  VIEWERS_TUBE
  YOUTUBE
  VIMEO
  DAILYMOTION
  OTHER
}

enum LiveStreamVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  username                   String              @unique
  passwordHash               String?
  displayName                String
  emailVerified              Boolean             @default(false)
  image                      String?
  role                       UserRole            @default(VIEWER)
  signupType                 AccountType         @default(VIEWER)
  creatorAgreementVersion    String?
  creatorAgreementAcceptedAt DateTime?
  creatorSuspendedUntil      DateTime?
  creatorTerminatedAt        DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  channel                    Channel?
  likes                      VideoLike[]
  comments                   Comment[]
  subscriptions              Subscription[]
  accounts                   Account[]
  sessions                   Session[]
  moderationStrikes          ModerationStrike[]  @relation("StrikeOwner")
  moderationAppeals          ModerationAppeal[]  @relation("AppealAuthor")
  storageConnections         StorageConnection[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Channel {
  id          String         @id @default(cuid())
  userId      String         @unique
  name        String
  slug        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation(fields: [userId], references: [id])
  videos      Video[]
  liveStreams LiveStream[]
  subscribers Subscription[]
}

model StorageConnection {
  id                      String                  @id @default(cuid())
  userId                  String
  provider                String                  @default("BACKBLAZE_B2")
  region                  String
  bucketName              String
  endpoint                String
  keyId                   String
  encryptedApplicationKey String
  prefix                  String                  @default("viewers-tube")
  label                   String?
  isDefault               Boolean                 @default(false)
  status                  StorageConnectionStatus @default(PENDING)
  verifiedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  owner                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos                  Video[]

  @@index([status])
  @@index([userId, status])
  @@index([userId, isDefault])
}

model Video {
  id                  String             @id @default(cuid())
  channelId           String
  title               String
  description         String?
  isShort             Boolean            @default(false)
  videoUrl            String?
  storageConnectionId String?
  storageKey          String?
  contentType         String?
  sizeBytes           BigInt?
  thumbnailUrl        String?
  language            String?
  category            String?
  status              VideoStatus        @default(PROCESSING)
  visibility          VideoVisibility    @default(PUBLIC)
  scheduledAt         DateTime?
  scheduledVisibility VideoVisibility?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  removedAt           DateTime?
  removalReason       String?
  channel             Channel            @relation(fields: [channelId], references: [id])
  storageConnection   StorageConnection? @relation(fields: [storageConnectionId], references: [id], onDelete: Restrict)
  renditions          VideoRendition[]
  transcodeJob        TranscodeJob?
  likes               VideoLike[]
  comments            Comment[]
  moderationStrikes   ModerationStrike[]

  @@index([category, createdAt])
  @@index([isShort, createdAt])
  @@index([status, visibility])
  @@index([storageConnectionId])
}

model ExternalVideo {
  id               String        @id @default(cuid())
  provider         VideoProvider
  providerVideoId  String
  title            String
  description      String?
  thumbnailUrl     String?
  canonicalUrl     String
  embedUrl         String?
  originalLanguage String?
  category         String?
  ageRestricted    Boolean       @default(false)
  embeddingAllowed Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([provider, providerVideoId])
  @@index([category, ageRestricted])
  @@index([provider, createdAt])
}

model VideoLike {
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@id([userId, videoId])
}

model Subscription {
  subscriberId String
  channelId    String
  createdAt    DateTime @default(now())
  subscriber   User     @relation(fields: [subscriberId], references: [id])
  channel      Channel  @relation(fields: [channelId], references: [id])

  @@id([subscriberId, channelId])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  videoId   String
  parentId  String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  video     Video     @relation(fields: [videoId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@index([videoId, createdAt])
}

model ModerationStrike {
  id                 String            @id @default(cuid())
  userId             String
  videoId            String?
  strikeNumber       Int
  policyCode         String
  reason             String
  suspensionDays     Int
  issuedAt           DateTime          @default(now())
  suspensionEndsAt   DateTime?
  status             StrikeStatus      @default(ACTIVE)
  notificationSentAt DateTime?
  user               User              @relation("StrikeOwner", fields: [userId], references: [id], onDelete: Restrict)
  video              Video?            @relation(fields: [videoId], references: [id], onDelete: SetNull)
  appeal             ModerationAppeal?

  @@index([userId, status, issuedAt])
  @@index([videoId])
}

model ModerationAppeal {
  id           String           @id @default(cuid())
  strikeId     String           @unique
  userId       String
  message      String
  status       AppealStatus     @default(OPEN)
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  reviewerNote String?
  strike       ModerationStrike @relation(fields: [strikeId], references: [id], onDelete: Restrict)
  submittedBy  User             @relation("AppealAuthor", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

enum TranscodeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model TranscodeJob {
  id        String             @id @default(cuid())
  videoId   String             @unique
  status    TranscodeJobStatus @default(PENDING)
  attempts  Int                @default(0)
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  video     Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model VideoRendition {
  id          String   @id @default(cuid())
  videoId     String
  height      Int
  width       Int
  bandwidth   Int
  playlistKey String
  createdAt   DateTime @default(now())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, height])
  @@index([videoId])
}

model LiveStream {
  id            String               @id @default(cuid())
  channelId     String
  title         String
  description   String?
  streamPath    String               @unique
  streamKeyHash String
  browserStreamKeyHash String?
  visibility    LiveStreamVisibility @default(PUBLIC)
  enabled       Boolean              @default(true)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  channel       Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, enabled, createdAt])
  @@index([visibility, enabled])
}
