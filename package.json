    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.20",
    "hls.js": "^1.7.4",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
